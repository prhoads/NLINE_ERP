<tryton>
    <data>
        <record model="res.group" id="group_read_only">
            <field name="name">N-Line Read Only</field>
        </record>

        <record model="ir.message" id="msg_role_code_unique">
            <field name="text">The code of a role must be unique.</field>
        </record>

        <record model="ir.ui.view" id="role_view_list">
            <field name="model">nline.role</field>
            <field name="type">tree</field>
            <field name="name">role_list</field>
        </record>
        <record model="ir.ui.view" id="role_view_form">
            <field name="model">nline.role</field>
            <field name="type">form</field>
            <field name="name">role_form</field>
        </record>
        <record model="ir.action.act_window" id="act_role">
            <field name="name">N-Line Roles</field>
            <field name="res_model">nline.role</field>
        </record>
        <record model="ir.action.act_window.view" id="act_role_view1">
            <field name="sequence" eval="10"/>
            <field name="view" ref="role_view_list"/>
            <field name="act_window" ref="act_role"/>
        </record>
        <record model="ir.action.act_window.view" id="act_role_view2">
            <field name="sequence" eval="20"/>
            <field name="view" ref="role_view_form"/>
            <field name="act_window" ref="act_role"/>
        </record>
        <menuitem parent="res.menu_res" action="act_role"
            sequence="30" id="menu_role"/>
        <record model="ir.ui.menu-res.group" id="menu_role_group_admin">
            <field name="menu" ref="menu_role"/>
            <field name="group" ref="res.group_admin"/>
        </record>

        <record model="ir.model.access" id="access_role">
            <field name="model" search="[('model', '=', 'nline.role')]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_role_admin">
            <field name="model" search="[('model', '=', 'nline.role')]"/>
            <field name="group" ref="res.group_admin"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_delete" eval="True"/>
        </record>

        <record model="ir.model.access" id="access_role_group">
            <field name="model" search="[('model', '=', 'nline.role-res.group')]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_role_group_admin">
            <field name="model" search="[('model', '=', 'nline.role-res.group')]"/>
            <field name="group" ref="res.group_admin"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_delete" eval="True"/>
        </record>

        <record model="ir.ui.view" id="user_view_form">
            <field name="model">res.user</field>
            <field name="inherit" ref="res.user_view_form"/>
            <field name="name">user_form</field>
        </record>
    </data>
