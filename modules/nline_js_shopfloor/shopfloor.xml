<tryton>
    <data>
        <record model="ir.rule.group" id="rule_group_labor_ticket_companies">
            <field name="name">User in companies</field>
            <field name="model"
                search="[('model', '=', 'nline.js.labor_ticket')]"/>
            <field name="global_p" eval="True"/>
        </record>
        <record model="ir.rule" id="rule_labor_ticket_companies">
            <field name="domain"
                eval="[('company', 'in', Eval('companies', []))]"
                pyson="1"/>
            <field name="rule_group" ref="rule_group_labor_ticket_companies"/>
        </record>

        <!-- Everyone reads; the production group (shop floor) writes -->
        <record model="ir.model.access" id="access_resource_member">
            <field name="model" search="[('model', '=', 'nline.js.resource.member')]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_resource_member_production">
            <field name="model" search="[('model', '=', 'nline.js.resource.member')]"/>
