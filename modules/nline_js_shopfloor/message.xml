            <field name="text">Only %(received)s parts of work order "%(production)s" were received.</field>
        </record>
        <record model="ir.message" id="msg_not_clocked_in">
            <field name="text">"%(employee)s" is not clocked in.</field>
        </record>
        <record model="ir.message" id="msg_clocked_in">
            <field name="text">"%(employee)s" is already clocked in.</field>
        </record>
