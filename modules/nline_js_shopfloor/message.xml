<tryton>
    <data grouped="1">
        <record model="ir.message" id="msg_members_not_group">
            <field name="text">Only a resource of type Group has members: "%(resource)s".</field>
        </record>
        <record model="ir.message" id="msg_group_nested">
            <field name="text">A group cannot be a member of another group: "%(resource)s".</field>
        </record>
        <record model="ir.message" id="msg_group_itself">
            <field name="text">A group cannot be its own member: "%(resource)s".</field>
        </record>
        <record model="ir.message" id="msg_view_duplicate">
            <field name="text">Resource "%(resource)s" is already in shop view "%(view)s".</field>
        </record>
        <record model="ir.message" id="msg_clock_no_unique">
            <field name="text">The clock number must be unique.</field>
        </record>
        <record model="ir.message" id="msg_employee_delete_labor">
            <field name="text">Delete denied: employee "%(employee)s" has labor transactions.</field>
        </record>
        <record model="ir.message" id="msg_clock_out_before_in">
            <field name="text">The clock out must be after the clock in.</field>
        </record>
        <record model="ir.message" id="msg_deviated_reason">
            <field name="text">A deviated quantity needs a reason code.</field>
        </record>
        <record model="ir.message" id="msg_ticket_operation">
            <field name="text">Choose the work order operation (Sub/Seq) of the labor.</field>
        </record>
        <record model="ir.message" id="msg_ticket_employee">
            <field name="text">Enter or scan the employee clock number first.</field>
        </record>
        <record model="ir.message" id="msg_ticket_delete_saved">
            <field name="text">Labor transaction "%(ticket)s" is saved: reverse it in Labor Entry instead.</field>
