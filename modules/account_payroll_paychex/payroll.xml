<tryton>
    <data>
        <menuitem
            name="Payroll"
            parent="account.menu_account"
            sequence="60"
            id="menu_payroll"/>

        <record model="ir.ui.view" id="mapping_view_form">
            <field name="model">account.payroll.paychex.mapping</field>
            <field name="type">form</field>
            <field name="name">mapping_form</field>
        </record>
        <record model="ir.ui.view" id="mapping_view_list">
            <field name="model">account.payroll.paychex.mapping</field>
            <field name="type">tree</field>
            <field name="name">mapping_list</field>
        </record>
        <record model="ir.action.act_window" id="act_mapping_form">
            <field name="name">Paychex Mappings</field>
            <field name="res_model">account.payroll.paychex.mapping</field>
            <field name="domain"
                eval="[('company', '=', Eval('context', {}).get('company', -1))]"
                pyson="1"/>
        </record>
        <record model="ir.action.act_window.view" id="act_mapping_form_view1">
            <field name="sequence" eval="10"/>
            <field name="view" ref="mapping_view_list"/>
            <field name="act_window" ref="act_mapping_form"/>
        </record>
        <record model="ir.action.act_window.view" id="act_mapping_form_view2">
            <field name="sequence" eval="20"/>
            <field name="view" ref="mapping_view_form"/>
            <field name="act_window" ref="act_mapping_form"/>
        </record>
        <menuitem
            parent="menu_payroll"
            action="act_mapping_form"
            sequence="20"
            id="menu_mapping_form"/>

        <record model="ir.model.access" id="access_mapping">
            <field name="model" search="[('model', '=', 'account.payroll.paychex.mapping')]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_mapping_account_admin">
            <field name="model" search="[('model', '=', 'account.payroll.paychex.mapping')]"/>
            <field name="group" ref="account.group_account_admin"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_delete" eval="True"/>
        </record>
        <record model="ir.model.access" id="access_mapping_account">
            <field name="model" search="[('model', '=', 'account.payroll.paychex.mapping')]"/>
            <field name="group" ref="account.group_account"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_delete" eval="False"/>
        </record>

        <record model="ir.rule.group" id="rule_group_mapping_companies">
            <field name="name">User in companies</field>
            <field name="model" search="[('model', '=', 'account.payroll.paychex.mapping')]"/>
            <field name="global_p" eval="True"/>
        </record>
        <record model="ir.rule" id="rule_mapping_companies">
            <field name="domain"
                eval="[('company', 'in', Eval('companies', []))]"
                pyson="1"/>
            <field name="rule_group" ref="rule_group_mapping_companies"/>
        </record>

        <record model="ir.ui.view" id="import_start_view_form">
            <field name="model">account.payroll.paychex.import.start</field>
            <field name="type">form</field>
            <field name="name">import_start_form</field>
        </record>
        <record model="ir.ui.view" id="import_distribute_view_form">
            <field name="model">account.payroll.paychex.import.distribute</field>
            <field name="type">form</field>
            <field name="name">import_distribute_form</field>
        </record>
        <record model="ir.ui.view" id="import_distribute_line_view_list">
            <field name="model">account.payroll.paychex.import.distribute.line</field>
            <field name="type">tree</field>
            <field name="name">import_distribute_line_list</field>
        </record>

        <record model="ir.action.wizard" id="wizard_import">
            <field name="name">Import Paychex Payroll</field>
            <field name="wiz_name">account.payroll.paychex.import</field>
        </record>
        <record model="ir.action-res.group" id="wizard_import_group_account">
            <field name="action" ref="wizard_import"/>
            <field name="group" ref="account.group_account"/>
        </record>
        <menuitem
            parent="menu_payroll"
            action="wizard_import"
            sequence="10"
            id="menu_import"/>
    </data>
</tryton>
