<tryton>
    <data grouped="1">
        <record model="ir.message" id="msg_mapping_unique">
            <field name="text">A Paychex line can be mapped only once per company.</field>
        </record>
        <record model="ir.message" id="msg_report_invalid">
            <field name="text">The Paychex report can not be read: %(error)s</field>
        </record>
        <record model="ir.message" id="msg_report_already_imported">
            <field name="text">The Paychex payroll of check date %(check_date)s is already imported.</field>
        </record>
        <record model="ir.message" id="msg_distribution_not_total">
            <field name="text">The distribution of "%(line)s" must total %(total)s.</field>
        </record>
        <record model="ir.message" id="msg_mapping_to_complete">
            <field name="text">Paychex Mappings to Complete</field>
        </record>
    </data>
</tryton>
