        </record>

        <record model="ir.action.url" id="url_desk_register">
            <field name="name">Check Register</field>
            <field name="url">desk/index.html#/register</field>
        </record>
        <menuitem parent="bank.menu_banking" action="url_desk_register"
            sequence="3" id="menu_desk_register"/>
        <record model="ir.ui.menu-res.group" id="menu_desk_register_group">
            <field name="menu" ref="menu_desk_register"/>
            <field name="group" ref="account.group_account"/>
        </record>
