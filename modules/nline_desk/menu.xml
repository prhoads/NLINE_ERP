<tryton>
    <data>
        <!-- The N-Line screens in the Tryton menus: each opens in a Tryton
             tab (custom.js), only for the groups that may use it; the ones
             that write are hidden from read-only users -->
        <record model="ir.action.url" id="url_desk_bills">
            <field name="name">Enter Bills</field>
            <field name="nline_writes" eval="True"/>
            <field name="url">desk/index.html#/bills/new</field>
        </record>
        <menuitem parent="purchase.menu_purchase" action="url_desk_bills"
            sequence="1" id="menu_desk_bills"/>
        <record model="ir.ui.menu-res.group" id="menu_desk_bills_group">
            <field name="menu" ref="menu_desk_bills"/>
            <field name="group" ref="account.group_account"/>
        </record>
        <record model="ir.action-res.group" id="url_desk_bills_group">
            <field name="action" ref="url_desk_bills"/>
            <field name="group" ref="account.group_account"/>
        </record>

        <record model="ir.action.url" id="url_desk_pay_bills">
            <field name="name">Pay Bills</field>
            <field name="nline_writes" eval="True"/>
            <field name="url">desk/index.html#/bills/pay</field>
        </record>
        <menuitem parent="purchase.menu_purchase" action="url_desk_pay_bills"
            sequence="2" id="menu_desk_pay_bills"/>
        <record model="ir.ui.menu-res.group" id="menu_desk_pay_bills_group">
            <field name="menu" ref="menu_desk_pay_bills"/>
            <field name="group" ref="account.group_account"/>
        </record>
        <record model="ir.action-res.group" id="url_desk_pay_bills_group">
            <field name="action" ref="url_desk_pay_bills"/>
            <field name="group" ref="account.group_account"/>
        </record>

        <record model="ir.action.url" id="url_desk_vendors">
            <field name="name">Vendor Center</field>
            <field name="url">desk/index.html#/vendors</field>
        </record>
        <menuitem parent="purchase.menu_purchase" action="url_desk_vendors"
            sequence="3" id="menu_desk_vendors"/>
        <record model="ir.ui.menu-res.group" id="menu_desk_vendors_group">
            <field name="menu" ref="menu_desk_vendors"/>
            <field name="group" ref="account.group_account"/>
        </record>
        <record model="ir.action-res.group" id="url_desk_vendors_group">
            <field name="action" ref="url_desk_vendors"/>
