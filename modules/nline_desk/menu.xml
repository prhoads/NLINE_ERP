            <field name="group" ref="account.group_account"/>
        </record>

        <record model="ir.action.url" id="url_desk_customers">
            <field name="name">Customer Center</field>
            <field name="url">desk/index.html#/customers</field>
        </record>
        <menuitem parent="sale.menu_sale" action="url_desk_customers"
            sequence="3" id="menu_desk_customers"/>
        <record model="ir.ui.menu-res.group" id="menu_desk_customers_group">
            <field name="menu" ref="menu_desk_customers"/>
            <field name="group" ref="account.group_account"/>
        </record>
        <record model="ir.action-res.group" id="url_desk_customers_group">
            <field name="action" ref="url_desk_customers"/>
            <field name="group" ref="account.group_account"/>
        </record>

        <record model="ir.action.url" id="url_desk_checks">
            <field name="name">Write Checks</field>
            <field name="nline_writes" eval="True"/>
            <field name="url">desk/index.html#/checks/new</field>
        </record>
        <menuitem parent="bank.menu_banking" action="url_desk_checks"
            sequence="1" id="menu_desk_checks"/>
        <record model="ir.ui.menu-res.group" id="menu_desk_checks_group">
            <field name="menu" ref="menu_desk_checks"/>
            <field name="group" ref="account.group_account"/>
        </record>
        <record model="ir.action-res.group" id="url_desk_checks_group">
            <field name="action" ref="url_desk_checks"/>
            <field name="group" ref="account.group_account"/>
        </record>

        <record model="ir.action.url" id="url_desk_deposits">
            <field name="name">Make Deposits</field>
            <field name="nline_writes" eval="True"/>
            <field name="url">desk/index.html#/deposits/new</field>
        </record>
        <menuitem parent="bank.menu_banking" action="url_desk_deposits"
            sequence="2" id="menu_desk_deposits"/>
        <record model="ir.ui.menu-res.group" id="menu_desk_deposits_group">
            <field name="menu" ref="menu_desk_deposits"/>
