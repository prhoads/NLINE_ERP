        </record>
        <menuitem parent="sale.menu_sale" action="url_desk_invoices"
            sequence="1" id="menu_desk_invoices"/>
        <record model="ir.ui.menu-res.group" id="menu_desk_invoices_group">
            <field name="menu" ref="menu_desk_invoices"/>
            <field name="group" ref="account.group_account"/>
        </record>
        <record model="ir.action-res.group" id="url_desk_invoices_group">
            <field name="action" ref="url_desk_invoices"/>
            <field name="group" ref="account.group_account"/>
        </record>

        <record model="ir.action.url" id="url_desk_receive">
            <field name="name">Receive Payments</field>
            <field name="nline_writes" eval="True"/>
            <field name="url">desk/index.html#/payments/receive</field>
        </record>
        <menuitem parent="sale.menu_sale" action="url_desk_receive"
            sequence="2" id="menu_desk_receive"/>
        <record model="ir.ui.menu-res.group" id="menu_desk_receive_group">
            <field name="menu" ref="menu_desk_receive"/>
            <field name="group" ref="account.group_account"/>
        </record>
        <record model="ir.action-res.group" id="url_desk_receive_group">
