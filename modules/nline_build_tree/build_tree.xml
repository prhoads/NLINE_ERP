<tryton>
    <data>
        <record model="ir.ui.view" id="production_view_tree">
            <field name="model">production</field>
            <field name="type">tree</field>
            <field name="field_childs">legs</field>
            <field name="priority" eval="20"/>
            <field name="name">production_tree</field>
        </record>

        <record model="ir.action.act_window" id="act_build_tree">
            <field name="name">Build Tree</field>
            <field name="res_model">production</field>
            <field name="domain"
                eval="[('parent', '=', None), ('state', 'not in', ['done', 'cancelled'])]"
                pyson="1"/>
        </record>
        <record model="ir.action.act_window.view" id="act_build_tree_view1">
            <field name="sequence" eval="10"/>
            <field name="view" ref="production_view_tree"/>
            <field name="act_window" ref="act_build_tree"/>
        </record>
        <record model="ir.action.act_window.view" id="act_build_tree_view2">
            <field name="sequence" eval="20"/>
            <field name="view" ref="production.production_view_form"/>
            <field name="act_window" ref="act_build_tree"/>
        </record>
        <menuitem
            parent="production.menu_production"
            action="act_build_tree"
            sequence="12"
            id="menu_build_tree"/>

        <record model="ir.ui.view" id="material_card_view_list">
            <field name="model">production.material_card</field>
            <field name="inherit" ref="nline_work_order.material_card_view_list"/>
            <field name="name">material_card_list</field>
        </record>

        <record model="ir.action.report" id="report_traveler">
            <field name="name">Traveler</field>
            <field name="model">production</field>
            <field name="report_name">production.traveler</field>
            <field name="report">nline_build_tree/traveler.html</field>
            <field name="template_extension">html</field>
        </record>
        <record model="ir.action.keyword" id="report_traveler_keyword">
            <field name="keyword">form_print</field>
            <field name="model">production,-1</field>
            <field name="action" ref="report_traveler"/>
        </record>
    </data>
</tryton>
